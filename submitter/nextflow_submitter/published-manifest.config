/*
 * published-manifest.config
 *
 * Writes a TSV manifest of every file in the pipeline's output directory
 * when a run finishes successfully. Attach it to any pipeline:
 *
 *     nextflow run <pipeline> -c published-manifest.config [other options]
 *
 * Output directory is resolved in this order:
 *   1. NXF_MANIFEST_DIR environment variable (for pipelines that use a
 *      non-standard output param, or to point somewhere specific)
 *   2. params.outdir                 (nf-core and most DSL2 pipelines)
 *   3. workflow.outputDir            (-output-dir / workflow outputs, Nextflow 24.04+)
 *   4. <launchDir>/results
 *
 * The manifest is written into that directory as
 *   published_manifest_<runName>.tsv
 *
 * Columns: run_name, nextflow_version, outdir, publish_dir, relative_path,
 *          full_path, size_bytes
 *
 * Any error here is reported as a warning and never fails the run.
 */

workflow.onComplete = {
    try {
        // workflow can be null if the pipeline failed to compile
        if( workflow == null || !workflow.success )
            return

        // 1-4: resolve the output directory
        def target = System.getenv('NXF_MANIFEST_DIR') ?: params.outdir
        def outDir
        if( target )
            outDir = nextflow.Nextflow.file(target.toString())
        else if( workflow.metaClass.hasProperty(workflow, 'outputDir') && workflow.outputDir )
            outDir = workflow.outputDir
        else
            outDir = workflow.launchDir.resolve('results')

        outDir = outDir.toAbsolutePath()
        if( !outDir.exists() ) {
            System.err.println "WARN: [published-manifest] output directory not found, no manifest written: ${outDir.toUriString()}"
            return
        }

        def runName   = workflow.runName
        def nfVersion = workflow.nextflow.version.toString()
        def outDirStr = outDir.toUriString()
        def manifest  = outDir.resolve("published_manifest_${runName}.tsv".toString())

        // Collect rows, skipping folders and any manifest from this or earlier runs
        def rows = []
        outDir.eachFileRecurse { f ->
            if( f.isFile() && !(f.name ==~ /published_manifest_.*\.tsv/) ) {
                def abs = f.toAbsolutePath()
                rows << [
                    runName,
                    nfVersion,
                    outDirStr,
                    abs.parent.toUriString(),
                    outDir.relativize(abs).toString(),
                    abs.toUriString(),
                    f.size()
                ]
            }
        }
        rows.sort { it[4] }

        // Write once (safe on S3 / GCS / Azure, which don't support appends)
        def sb = new StringBuilder('run_name\tnextflow_version\toutdir\tpublish_dir\trelative_path\tfull_path\tsize_bytes\n')
        rows.each { r -> sb.append(r.join('\t')).append('\n') }
        manifest.text = sb.toString()

        println "[published-manifest] ${rows.size()} files listed in ${manifest.toUriString()}"
    }
    catch( Throwable e ) {
        System.err.println "WARN: [published-manifest] manifest not written: ${e.getClass().getSimpleName()}: ${e.message}"
    }
}
